---
interface Props {
  label?: string;
  title: string;
  highlight?: string;
  breakBeforeHighlight?: boolean;
  description?: string;
  compact?: boolean;
  image?: string;
  imageAlt?: string;
  imageCaption?: string;
}

const {
  label,
  title,
  highlight,
  breakBeforeHighlight = false,
  description,
  compact = false,
  image,
  imageAlt = "",
  imageCaption,
} = Astro.props;

const sectionClass = compact
  ? "bg-brand-surface pt-20 pb-10 md:pt-24 md:pb-12 px-6 relative overflow-hidden"
  : "bg-brand-surface pt-32 pb-20 px-6 relative overflow-hidden";
const headingClass = compact
  ? "font-serif text-brand-black text-[clamp(2.75rem,5.5vw,5.5rem)] leading-[1.05] font-medium"
  : "text-display text-brand-black";
---

<section class={sectionClass}>

  {!compact && (
    <div
      class="absolute inset-0 pointer-events-none select-none"
      aria-hidden="true"
      style="background: radial-gradient(ellipse at 70% 50%, color-mix(in srgb, var(--color-brand-sage) 8%, transparent), transparent 60%)"
    ></div>
  )}

  <div class="relative max-w-6xl mx-auto flex flex-col gap-4">
    {label && (
      <span class="text-xs font-semibold uppercase tracking-widest text-brand-terra">
        {label}
      </span>
    )}
    <h1 class={headingClass}>
      {title}
      {highlight && !breakBeforeHighlight && <span class="text-brand-sage"> {highlight}</span>}
      {highlight && breakBeforeHighlight && <><br /><span class="text-brand-sage">{highlight}</span></>}
    </h1>
    {description && (
      <p class={`${compact ? "text-lg" : "text-xl"} text-brand-black/60 max-w-2xl leading-relaxed mt-2`}>
        {description}
      </p>
    )}
  </div>
</section>

{image && (
  <figure class="relative w-full h-[35vh] min-h-[260px] md:min-h-[380px] overflow-hidden bg-brand-black">
    <img
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover"
      style="object-position: center 30%;"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </figure>
)}
