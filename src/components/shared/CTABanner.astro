---
import { PHONE } from "../../content/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Come see the home for yourself",
  description = "Tours most weekdays. No commitment, just a conversation.",
} = Astro.props;
---

<section class="bg-brand-sage px-6 py-20 md:py-24">
  <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-6">
    <h2 class="text-display-sm text-brand-white">{title}</h2>
    {description && (
      <p class="text-brand-white/80 text-[17px] leading-relaxed">{description}</p>
    )}
    <div class="flex flex-col sm:flex-row items-center gap-4 mt-2">
      <a
        href={`tel:${PHONE}`}
        class="inline-flex items-center justify-center bg-brand-white text-brand-black font-semibold px-8 py-3.5 rounded-lg hover:bg-brand-terra hover:text-brand-white transition-colors duration-200 min-h-[44px]"
      >
        Call {PHONE}
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center border-2 border-brand-white/50 text-brand-white font-semibold px-8 py-3.5 rounded-lg hover:bg-brand-white/10 transition-colors duration-200 min-h-[44px]"
      >
        Send a Message
      </a>
    </div>
  </div>
</section>
