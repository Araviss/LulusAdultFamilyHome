---
interface Props {
  label?: string;
  title: string;
  highlight?: string;
  description?: string;
  align?: "left" | "center";
  dark?: boolean;
}

const {
  label,
  title,
  highlight,
  description,
  align = "left",
  dark = false,
} = Astro.props;

const alignClass = align === "center" ? "text-center items-center" : "text-left items-start";
const textClass = dark ? "text-white" : "text-brand-black";
const descClass = dark ? "text-white/60" : "text-brand-black/60";
const labelClass = dark ? "text-brand-sage" : "text-brand-terra";
---

<div class={`flex flex-col gap-3 ${alignClass}`}>
  {label && (
    <span class={`text-xs font-semibold uppercase tracking-widest ${labelClass}`}>
      {label}
    </span>
  )}
  <h2 class={`text-display-sm ${textClass}`}>
    {title}{highlight && ` ${highlight}`}
  </h2>
  {description && (
    <p class={`text-[17px] max-w-2xl leading-relaxed mt-1 ${descClass}`}>
      {description}
    </p>
  )}
</div>
