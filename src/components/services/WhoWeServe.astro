---
import { WHO_WE_SERVE } from "../../content/services";
---

<section class="section-rule" style="background:#ffffff; padding:64px 24px;">
  <div style="max-width:72rem; margin:0 auto;">

    <!-- Section heading + intro -->
    <div style="margin-bottom:48px; max-width:560px;">
      <h2 style="font-family:var(--font-serif); font-size:clamp(2rem,3.2vw,2.75rem); line-height:1.1; font-weight:400; letter-spacing:-0.02em; color:#111111; margin:0 0 16px;">
        {WHO_WE_SERVE.heading}
      </h2>
      <p style="font-size:17px; color:rgba(17,17,17,0.65); line-height:1.65; margin:0;">
        {WHO_WE_SERVE.intro}
      </p>
    </div>

    <!-- Two-column lists -->
    <div class="who-grid">

      <!-- Good fit -->
      <div>
        <h3 style="font-family:var(--font-serif); font-size:1.125rem; font-weight:400; color:#111111; margin:0 0 24px; letter-spacing:-0.01em;">
          {WHO_WE_SERVE.goodFit.heading}
        </h3>
        <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;">
          {WHO_WE_SERVE.goodFit.items.map((item) => (
            <li style="font-size:16px; color:rgba(17,17,17,0.72); line-height:1.55;">{item}</li>
          ))}
        </ul>
      </div>

      <!-- Not a fit -->
      <div>
        <h3 style="font-family:var(--font-serif); font-size:1.125rem; font-weight:400; color:#111111; margin:0 0 24px; letter-spacing:-0.01em;">
          {WHO_WE_SERVE.notFit.heading}
        </h3>
        <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;">
          {WHO_WE_SERVE.notFit.items.map((item) => (
            <li style="font-size:16px; color:rgba(17,17,17,0.72); line-height:1.55;">{item}</li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (min-width: 768px) {
    .who-grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
</style>
