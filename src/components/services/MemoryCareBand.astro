---
import { MEMORY_CARE } from "../../content/services";
---

<section style="background:#1E2620; padding:96px 24px;">
  <div class="max-w-6xl mx-auto">
    <div style="max-width:65ch;">

      <h2 style="font-family:var(--font-serif); font-size:clamp(2rem,3.2vw,2.75rem); line-height:1.1; font-weight:400; letter-spacing:-0.02em; color:#ffffff; margin:0 0 32px;">
        {MEMORY_CARE.heading}
      </h2>

      <div style="display:flex; flex-direction:column; gap:20px;">
        {MEMORY_CARE.paragraphs.map((p) => (
          <p style="font-size:17px; color:rgba(255,255,255,0.82); line-height:1.7; margin:0;">{p}</p>
        ))}
      </div>


    </div>
  </div>
</section>
