---
import { CORE_CARE_INTRO, CORE_CLUSTERS } from "../../content/services";
---

<section class="section-rule" style="padding:64px 24px;">
  <div style="max-width:72rem; margin:0 auto;">

    <div class="core-grid">

      <!-- Left: sticky intro -->
      <div class="core-sticky">
        <h2 style="font-family:var(--font-serif); font-size:clamp(1.75rem,2.8vw,2.25rem); line-height:1.1; font-weight:400; letter-spacing:-0.02em; color:#111111; margin:0 0 16px;">
          {CORE_CARE_INTRO.heading}
        </h2>
        <p style="font-size:16px; color:rgba(17,17,17,0.65); line-height:1.65; margin:0; max-width:34ch;">
          {CORE_CARE_INTRO.body}
        </p>
      </div>

      <!-- Right: clusters -->
      <div>
        {CORE_CLUSTERS.map((cluster) => (
          <div style="border-top:1px solid rgba(17,17,17,0.08); padding-top:48px; padding-bottom:40px;">
            <h3 style="font-family:var(--font-serif); font-size:clamp(1.5rem,2.2vw,1.75rem); line-height:1.15; font-weight:400; color:#1E2620; letter-spacing:-0.01em; margin:0 0 16px;">
              {cluster.heading}
            </h3>
            <p style="font-size:17px; color:rgba(17,17,17,0.72); line-height:1.65; margin:0; max-width:65ch;">
              {cluster.body}
            </p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .core-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 768px) {
    .core-grid {
      grid-template-columns: 3fr 7fr;
      gap: 80px;
      align-items: start;
    }

  }
</style>
