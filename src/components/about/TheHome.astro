---
import { THE_HOME } from "../../content/about";
---

<section class="bg-brand-paper px-6 py-16 md:py-24 section-rule">
  <div class="max-w-6xl mx-auto">

    <div class="grid grid-cols-1 md:grid-cols-[58fr_42fr] gap-12 md:gap-16 items-start">

      <!-- Text left: eyebrow → heading → intro → body → details -->
      <div style="display:flex; flex-direction:column; gap:16px;">

        <div style="display:flex; flex-direction:column; gap:10px;">
<h2 style="font-family:var(--font-serif); font-size:clamp(2rem,3.5vw,2.75rem); line-height:1.15; letter-spacing:0; font-weight:500; color:#111111; margin:0;">
            {THE_HOME.heading}
          </h2>
          <p style="font-size:17px; color:rgba(17,17,17,0.72); line-height:1.65; margin:0;">
            {THE_HOME.description}
          </p>
        </div>

        <div style="display:flex; flex-direction:column; gap:14px;">
          {THE_HOME.body.map((p) => (
            <p style="font-size:17px; color:rgba(17,17,17,0.72); line-height:1.65; margin:0;">{p}</p>
          ))}
        </div>

        <!-- Details grid — below prose, slightly smaller -->
        <dl style="display:grid; grid-template-columns:1fr 1fr; gap:14px 24px; margin-top:8px; padding-top:24px; border-top:1px solid rgba(17,17,17,0.08);">
          {THE_HOME.details.map((item) => (
            <div style="display:flex; flex-direction:column; gap:2px;">
              <dt style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(17,17,17,0.4); font-weight:600;">{item.label}</dt>
              <dd style="font-size:14px; color:#111111; font-weight:500; margin:0;">{item.value}</dd>
            </div>
          ))}
        </dl>

      </div>

      <!-- Image right — top-aligned, 6px radius -->
      <div>
        <!-- REPLACE WITH REAL PHOTO — the home (exterior, living room, or backyard) -->
        <div style="aspect-ratio:4/3; max-height:340px; border-radius:6px; overflow:hidden; background:#EAE7E1; display:flex; align-items:center; justify-content:center;">
          <span style="font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:rgba(44,36,32,0.3); font-weight:500; text-align:center; padding:16px; line-height:1.6;">
            Replace with real photo —<br />the home
          </span>
        </div>
      </div>

    </div>
  </div>
</section>
