---
import { TESTIMONIAL } from "../../content/home";
---

<section class="bg-white px-6 py-20 md:py-28 section-rule">
  <div class="max-w-2xl mx-auto text-center">

    <blockquote class="flex flex-col items-center gap-5">
      <span style="font-family:var(--font-serif); font-size:56px; line-height:1; color:var(--color-brand-sage); opacity:0.35; margin-bottom:-8px;" aria-hidden="true">"</span>
      <p class="text-xl md:text-2xl text-brand-black leading-relaxed" style="font-family:var(--font-serif);">
        {TESTIMONIAL.quote}
      </p>
      <footer>
        <cite class="not-italic text-sm text-brand-muted">
          {TESTIMONIAL.author}, {TESTIMONIAL.relationship}
        </cite>
      </footer>
    </blockquote>

  </div>
</section>
