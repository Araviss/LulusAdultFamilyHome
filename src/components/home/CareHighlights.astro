---
import { CARE_PILLARS } from "../../content/home";
---

<section class="bg-brand-paper px-6 pt-16 pb-20 md:pt-20 md:pb-28 section-rule">
  <div class="max-w-6xl mx-auto">

    <!-- Section header band: eyebrow above, heading/deck bottom-aligned -->
    <div style="margin-bottom:60px;">
<div style="display:flex; flex-direction:row; align-items:flex-end; column-gap:48px; flex-wrap:wrap; row-gap:16px;">
        <div style="flex:0 0 40%; min-width:260px;">
          <h2 style="font-family:var(--font-serif); font-size:clamp(2rem,3.2vw,2.75rem); line-height:1.15; letter-spacing:0; font-weight:500; color:#111111; margin:0;">
            Care that feels like home
          </h2>
        </div>
        <div style="flex:1; max-width:360px;">
          <p style="font-size:17px; line-height:1.6; color:#5F5E5A; margin:0;">
            Small by design. Every resident knows our name, and we know theirs.
          </p>
        </div>
      </div>
    </div>

    <!-- Alternating image/text rows -->
    <div style="display:flex; flex-direction:column; gap:64px;">
      {CARE_PILLARS.map((pillar, i) => (
        <div
          class={`grid grid-cols-1 md:grid-cols-[45fr_55fr] items-start ${i % 2 === 1 ? "md:[&>*:first-child]:order-2 md:[&>*:last-child]:order-1" : ""}`}
          style="gap:48px;"
          data-testid="care-card"
        >
          <!-- Image -->
          <div style="aspect-ratio:4/3; max-height:320px; border-radius:6px; overflow:hidden; background:#F5F4F1;">
            <img
              src={pillar.image}
              alt={pillar.imageAlt}
              style="width:100%; height:100%; object-fit:cover; display:block;"
              loading="lazy"
            />
          </div>

          <!-- Text -->
          <div style="display:flex; flex-direction:column; gap:12px; padding-top:36px;">
            <h3 style="font-family:var(--font-serif); font-size:1.375rem; line-height:1.2; font-weight:500; color:#111111; letter-spacing:0; margin:0;">
              {pillar.shortTitle}
            </h3>
            <p style="font-family:var(--font-serif); font-size:18px; line-height:1.5; color:rgba(17,17,17,0.78); margin:0;">
              {pillar.lede}
            </p>
            <!-- CONFIRM WITH OWNER before publishing — see home.ts comments per row -->
            <div style="margin-top:8px;">
              <div style="width:40px; height:1px; background:#E0DCD2; margin-bottom:16px;"></div>
              <span style="font-size:14px; color:#6B6B63; line-height:1.4;">{pillar.detail}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
