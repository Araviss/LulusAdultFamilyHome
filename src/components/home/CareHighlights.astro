---
import { CARE_PILLARS } from "../../content/home";
---

<section class="px-10 pt-10 pb-20 md:pt-12 md:pb-28 bg-brand-paper section-rule">
  <div class="max-w-6xl mx-auto">

    <div class="care-panel" style="background:#ffffff; border-radius:24px; position:relative; overflow:visible;">

      <!-- Section header band: left 40% / right 60%, bottom-aligned -->
      <div style="display:flex; flex-direction:column; gap:0; margin-bottom:60px;">

        <!-- Eyebrow sits above the aligned pair, alone -->
        <span style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--color-brand-terra); font-weight:600; margin-bottom:12px;">
          Why Lulu's Care
        </span>

        <!-- Aligned pair: heading left, sentence right, bottom-aligned -->
        <div style="display:flex; flex-direction:row; align-items:flex-end; column-gap:48px;">

          <div style="flex:0 0 40%;">
            <h2 style="font-family:var(--font-serif); font-size:clamp(2rem,3.2vw,2.75rem); line-height:1.1; letter-spacing:-0.02em; font-weight:400; color:#111111; margin:0;">
              Care that feels like home
            </h2>
          </div>

          <div style="flex:0 0 60%; max-width:360px;">
            <p style="font-size:17px; line-height:1.6; color:#5F5E5A; margin:0;">
              Small by design. Every resident knows our name, and we know theirs.
            </p>
          </div>

        </div>
      </div>

      <!-- Rows -->
      <div style="display:flex; flex-direction:column; gap:64px;">
        {CARE_PILLARS.map((pillar, i) => (
          <div
            class={`grid grid-cols-1 md:grid-cols-[45fr_55fr] items-start ${i % 2 === 1 ? "md:[&>*:first-child]:order-2 md:[&>*:last-child]:order-1" : ""}`}
            style="gap:48px;"
            data-testid="care-card"
          >
            <!-- Image: 4:3, max-height 320px, interlock -48px into next row -->
            <!-- Middle row bleeds 60px past panel right edge -->
            <div style={`position:relative; margin-bottom:-48px; ${i === 1 ? "margin-right:-60px;" : ""}`}>
              <div style="border-radius:12px; overflow:hidden; aspect-ratio:4/3; max-height:320px; background:#F5F4F1;">
                <img
                  src={pillar.image}
                  alt={pillar.imageAlt}
                  style="width:100%; height:100%; object-fit:cover; display:block;"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Text: short serif heading → 18px serif lede → small-caps detail -->
            <div style="display:flex; flex-direction:column; gap:12px; padding-top:36px;">
              <h3 style="font-family:var(--font-serif); font-size:1.375rem; line-height:1.2; font-weight:400; color:#111111; letter-spacing:-0.01em;">
                {pillar.shortTitle}
              </h3>
              <p style="font-family:var(--font-serif); font-size:18px; line-height:1.5; color:rgba(17,17,17,0.78);">
                {pillar.lede}
              </p>

              <!-- CONFIRM WITH OWNER before publishing — see home.ts comments per row -->
              <div style="margin-top:8px;">
                <div style="width:40px; height:1px; background:#E0DCD2; margin-bottom:16px;"></div>
                <span style="font-size:14px; color:#6B6B63; line-height:1.4;">{pillar.detail}</span>
              </div>

            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .care-panel {
    padding: 48px;
  }
  @media (min-width: 768px) {
    .care-panel {
      padding: 80px;
    }
  }
</style>
